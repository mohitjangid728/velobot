# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the client or the widget bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Razorpay ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
# Public key id — safe to expose, used by the Checkout.js popup.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# One Razorpay Plan per (tier x interval x currency). Create these via
# `pnpm --filter @velobot/web exec node scripts/create-razorpay-plans.mjs`
# (prints this exact block, ready to paste) rather than clicking through
# the dashboard 14 times — see lib/razorpay/plan-map.ts for how these are
# read.
RAZORPAY_PLAN_HOBBY_MONTHLY_USD=plan_...
RAZORPAY_PLAN_HOBBY_MONTHLY_INR=plan_...
RAZORPAY_PLAN_HOBBY_YEARLY_USD=plan_...
RAZORPAY_PLAN_HOBBY_YEARLY_INR=plan_...
RAZORPAY_PLAN_GROWTH_MONTHLY_USD=plan_...
RAZORPAY_PLAN_GROWTH_MONTHLY_INR=plan_...
RAZORPAY_PLAN_GROWTH_YEARLY_USD=plan_...
RAZORPAY_PLAN_GROWTH_YEARLY_INR=plan_...
RAZORPAY_PLAN_BUSINESS_MONTHLY_USD=plan_...
RAZORPAY_PLAN_BUSINESS_MONTHLY_INR=plan_...
RAZORPAY_PLAN_BUSINESS_YEARLY_USD=plan_...
RAZORPAY_PLAN_BUSINESS_YEARLY_INR=plan_...

# Seat add-on — always billed monthly regardless of the org's own plan
# interval (see packages/shared/src/plans.ts ADDONS.seat). The one-time
# messages add-on needs no Plan at all — it's a plain Razorpay Order with
# an inline amount, no pre-created price object.
RAZORPAY_PLAN_ADDON_SEAT_USD=plan_...
RAZORPAY_PLAN_ADDON_SEAT_INR=plan_...

# ── Rate limiting (Upstash Redis REST) ──────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Transactional email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_...
# Must be on a domain verified in Resend (SPF/DKIM DNS records) or sends fail.
RESEND_FROM_EMAIL=VeloBot <admin@techfen.com>

# ── Escalation alert webhooks (optional, either/both) ───────────────────
SLACK_ALERT_WEBHOOK_URL=
DISCORD_ALERT_WEBHOOK_URL=

# ── App URLs ─────────────────────────────────────────────────────────────
# Used for building invite links and CORS checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Where apps/widget's built bundle is hosted in production.
NEXT_PUBLIC_WIDGET_CDN_URL=https://cdn.yourdomain.com/widget.js

# Shared secret used by supabase/functions/escalation-watcher to call back
# into the Next.js internal notification route.
INTERNAL_FUNCTIONS_SECRET=change-me

# ── Error monitoring (Sentry, optional) ─────────────────────────────────
# Leave both unset to run with error monitoring fully disabled — the SDK
# no-ops cleanly without a DSN, nothing is sent anywhere.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for uploading source maps — leave unset to skip that step.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Product analytics (PostHog, optional) ───────────────────────────────
# Leave unset to run with analytics fully disabled.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
