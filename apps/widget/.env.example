# Baked into the widget bundle at build time (Vite `define`) — these are
# public by design (the anon key is meant to be exposed client-side; access
# control comes from RLS + origin whitelisting, not secrecy of this key).
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
